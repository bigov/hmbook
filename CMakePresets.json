{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-app",
      "inherits": "base-debug",
      "displayName": "Dev: App",
      "description": "Сборка GUI-приложения hmbook"
    },
    {
      "name": "base-relwithdebinfo",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-app-debug-symbols",
      "inherits": "base-relwithdebinfo",
      "displayName": "Dev: App (Debug Symbols)",
      "description": "Сборка GUI-приложения hmbook с символами отладки (RelWithDebInfo)"
    },
    {
      "name": "dev-tests",
      "inherits": "base-debug",
      "displayName": "Dev: Tests",
      "description": "Сборка (без дополнительных cache-переключателей)"
    },
    {
      "name": "dev-all",
      "inherits": "base-debug",
      "displayName": "Dev: All",
      "description": "Сборка (без дополнительных cache-переключателей)"
    }
  ],
  "buildPresets": [
    {
      "name": "build-app",
      "configurePreset": "dev-app"
    },
    {
      "name": "build-app-debug-symbols",
      "configurePreset": "dev-app-debug-symbols"
    },
    {
      "name": "build-tests",
      "configurePreset": "dev-tests"
    },
    {
      "name": "build-all",
      "configurePreset": "dev-all"
    }
  ]
}
