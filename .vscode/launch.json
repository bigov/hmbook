{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "hmbook (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/hmbook.exe",
      "cwd": "${workspaceFolder}/build/debug",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,

      "preLaunchTask": "CMake: build hmbook",

      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Включить pretty-printing для gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Задать стиль дизассемблирования Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
