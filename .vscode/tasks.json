{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Generate compile_commands.json",
      "type": "shell",
      "command": "cmake --preset Debug --fresh",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "CMake: build hmbook",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug", "--target", "hmbook"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Сборка цели hmbook с символами отладки в build/Debug."
    },
    {
      "label": "hmbook: run",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/hmbook.exe",
      "args": [],
      "options": { "cwd": "${workspaceFolder}/build/Debug" },
      "dependsOn": ["CMake: build hmbook"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Сборка и запуск hmbook без отладчика."
    }
  ]
}
