{
  "cmake.configureOnOpen": true,
  "cmake.useCMakePresets": "always",
  "cmake.configurePreset": "dev-app",
  "cmake.buildPreset": "build-app",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/dev-app/compile_commands.json",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.files.exclude": {
    "**/third_party/**": true
  },
  "search.exclude": {
    "**/third_party/**": true
  },
  "files.readonlyInclude": {
    "**/third_party/**": true
  },
  "CodeGPT.apiKey": "OpenAI"
}
