{
  "cmake.configureOnOpen": true,
  "cmake.useCMakePresets": "always",
  "cmake.configurePreset": "dev-app-debug-symbols",
  "cmake.buildPreset": "build-app-debug-symbols",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/dev-app-debug-symbols/compile_commands.json",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.files.exclude": {
    "**/.deps-str/**": true,
    "**/.deps-src/**": true,
    "**/_deps/**": true
  },
  "search.exclude": {
    "**/.deps-str/**": true,
    "**/.deps-src/**": true,
    "**/_deps/**": true
  }
}
